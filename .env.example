# 灵枢部署配置样例（复制成 .env 后按需修改；.env 已被 .gitignore 忽略）
#
#   cp .env.example .env
#   docker compose up -d
#
# 不建 .env 也能跑：下面每一项在 docker-compose.yml 里都有同样的默认值。
# 完整变量说明（含 MAGPIE_*）见 README.md「可覆盖的环境变量」与 docs/deploy/README.md。

# —— 镜像（部署机只拉镜像，不构建）——
# 与 .github/workflows/build-images.yml 推送到 ACR 的 tag 对应。升级 = 改这一行 → docker compose up -d
LINGSHU_IMAGE_TAG=v0.14.0-rc1
LINGSHU_REGISTRY=registry.cn-hangzhou.aliyuncs.com/spencerswagger

# —— 对外 ——
APP_PORT=80
TZ=Asia/Shanghai

# —— 数据库（compose 内的 postgres；生产请改口令）——
POSTGRES_USER=llmgw
POSTGRES_PASSWORD=llmgw
POSTGRES_DB=llmgw

# —— 登录 ——
JWT_TTL_MINUTES=360

# —— 代理侧（magpie）——
# tag 不带 v 前缀（0.1.4458 对、v0.1.4458 拉不到）
MAGPIE_IMAGE=ghcr.io/yetone/magpie:0.1.4458
MAGPIE_UI_PORT=3430
# 下面两把留空 = 首次 up 自动生成并落在 magpie_secret 卷（推荐）；
# 只有手工接管时才填。MAGPIE_WEB_KEY 至少 16 个字符。
# MAGPIE_ADMIN_KEY=
# MAGPIE_WEB_KEY=

# —— 结算链路（V3 kill-switch，默认关）——
# 不设置/留空 = 走旧结算口径；置 1 启用新链路（组 ref 候选 + unpriced 兜底 + 补收）。
# dry-run 分桶结果确认后再开；出账异常时清空重启即回退。
# V3_SETTLE_ENABLED=1
